ANTHROPIC_API_KEY=your-anthropic-api-key-here

VITE_SUPABASE_URL=your-supabase-project-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

RESEND_API_KEY=your-resend-api-key-here

# Google Analytics. From a GA4 property > Admin > Data Streams > your web
# stream - the Measurement ID looks like G-XXXXXXXXXX. Public (ships in the
# browser bundle), no secret involved.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Card payments. Use the test keys (sk_test_...) until you are ready to go live.
STRIPE_SECRET_KEY=your-stripe-secret-key-here
# Printed by `stripe listen` when testing locally, or shown in the Stripe
# dashboard under Developers > Webhooks once the site is deployed
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here

# Shared password Supabase must send with every shipping webhook call.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_WEBHOOK_SECRET=generate-a-long-random-string-here

# Set these once the site is deployed so email links point at the real site.
# One server now serves both the shop and the API, so these are the SAME
# URL — no separate api.* subdomain needed.
# SITE_BASE_URL=https://helloqt.co.uk
# BACKEND_BASE_URL=https://helloqt.co.uk
# Extra sites allowed to call this API, comma separated
# ALLOWED_ORIGINS=https://helloqt.co.uk
# Set to 1 when running behind a host's proxy (Vercel, Render, Fly) so rate
# limiting sees the real visitor IP instead of the proxy's
# TRUST_PROXY=1

# Pinterest ads. The Tag ID is public (ships in the browser bundle) and
# comes from Ads Manager > Conversions > Install Pinterest tag. The access
# token and ad account ID are server-side only, from Ads Manager >
# Conversions > Set up API - used to report confirmed purchases straight to
# Pinterest even when a customer's browser blocks the tag itself.
# VITE_PINTEREST_TAG_ID=your-pinterest-tag-id-here
# PINTEREST_ACCESS_TOKEN=your-pinterest-conversions-api-access-token-here
# PINTEREST_AD_ACCOUNT_ID=your-pinterest-ad-account-id-here

# Pauses the whole shop with an on-brand "back very soon" page, without any
# code change — flip to true in Render when making a bigger change, back to
# false (or delete it) when done. Stripe and Supabase webhooks still work
# while this is on, so a payment or shipping update is never lost.
# MAINTENANCE_MODE=true
# Optional: shown as a note on the maintenance page
# MAINTENANCE_MESSAGE=Updating our prices, back in an hour!
